{
  "name": "poroteo-legislativo-backend",
  "version": "0.1.0",
  "description": "API del prototipo de Poroteo Legislativo (Democracia en Red · HMP)",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "datos:exportar": "node --env-file-if-exists=.env scripts/dataset/exportar-supabase.mjs",
    "datos:construir": "node scripts/dataset/construir.mjs",
    "modelo:lsa": "node scripts/modelo/lsa.mjs 96",
    "modelo:historia": "node scripts/modelo/historia.mjs",
    "modelo:evaluar": "node scripts/modelo/evaluar.mjs lsa base,logistica,gbdt && node scripts/modelo/reporte.mjs",
    "modelo:entrenar": "node scripts/modelo/entrenar.mjs logistica",
    "modelo:actualizar": "npm run datos:exportar && npm run datos:construir && npm run modelo:lsa && npm run modelo:historia && npm run modelo:entrenar",
    "supabase:cargar": "node --env-file-if-exists=.env scripts/supabase/cargar-datos-limpios.mjs",
    "e2e": "node --env-file-if-exists=.env scripts/e2e/flujo-poroteo-ia.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@supabase/supabase-js": "2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
