# ---------------------------------------------------------------
# Poroteo Legislativo · Backend
# Copiá este archivo a .env y completá los valores.
# .env NUNCA se sube a git.
# ---------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor
PORT=4000

# Vacío: sin proxy confiable. En despliegue, solo CIDR/IP de proxies conocidos.
TRUST_PROXY=
# Cookies host-only HttpOnly. Secure automático con NODE_ENV=production.
# Preferir frontend y API bajo el mismo sitio o proxy /api.
SESSION_SAME_SITE=lax
SESSION_DAYS=7
# Emisor por defecto: SUPABASE_URL/auth/v1. Ajustar solo para un emisor verificado.
# SUPABASE_JWT_ISSUER=https://<project-id>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Orígenes permitidos para CORS (separados por coma, sin barra final)
CORS_ORIGINS=http://localhost:5173

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://<project-id>.supabase.co
# Clave pública: solo lectura (las tablas tienen RLS con lectura pública)
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: saltea RLS. Necesaria para escribir los poroteos.
# NUNCA va en el frontend ni en git.
SUPABASE_SECRET_KEY=

# Rate limit general: N requests por ventana (en ms) por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Rate limit para escrituras (POST/PUT/DELETE)
RATE_LIMIT_WRITE_MAX=60

# Minutos que se cachean en memoria los 257 diputados actuales
CACHE_DIPUTADOS_MINUTOS=10

# Roles de aplicación: solo backend; lista vacía = ningún superadmin.
# Reiniciar el backend después de cambiarla. Cada cuenta debe confirmar su email.
SUPERADMIN_EMAILS=
# UUID de Supabase Auth (Authentication → Users) de cada superadmin, separados por coma.
# Se exige además del email: una cuenta nueva con el mismo email no hereda el rol.
# Vacía = ningún superadmin.
SUPERADMIN_USER_IDS=

# Predicción con IA (POST /api/poroteos/:id/prediccion). Ver docs/prediccion.md.
# URL del servicio Python de ml/ (vacío = no configurado).
PREDICTOR_URL=
PREDICTOR_TIMEOUT_MS=60000
# Sin PREDICTOR_URL y fuera de producción se usa un predictor SIMULADO (datos de mentira)
# para probar la interfaz. Poner false para desactivarlo. En producción no se permite.
# PREDICTOR_SIMULADO=true

# Red con inspeccion HTTPS (SELF_SIGNED_CERT_IN_CHAIN): usar certificados del sistema (Node >= 22.15)
# NODE_OPTIONS=--use-system-ca
