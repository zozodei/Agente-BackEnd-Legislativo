# ---------------------------------------------------------------
# Poroteo Legislativo · Backend
# Copiá este archivo a .env y completá los valores.
# .env NUNCA se sube a git.
# ---------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor
PORT=4000

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Orígenes permitidos para CORS (separados por coma, sin barra final)
CORS_ORIGINS=http://localhost:5173

# URL del front. El login con Google vuelve a FRONTEND_URL/auth/callback
# (agregala en Supabase → Authentication → URL Configuration → Redirect URLs).
# Si se deja vacía, se usa el primer origen de CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://<project-id>.supabase.co
# Clave pública: solo lectura (las tablas tienen RLS con lectura pública)
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: saltea RLS. Necesaria para escribir los poroteos.
# NUNCA va en el frontend ni en git.
SUPABASE_SECRET_KEY=

# Rate limit general: N requests por ventana (en ms) por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Rate limit para escrituras (POST/PUT/DELETE)
RATE_LIMIT_WRITE_MAX=60
# Rate limit para login y registro: N intentos por ventana (15 min) por IP
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Minutos que se cachean en memoria los 257 diputados actuales
CACHE_DIPUTADOS_MINUTOS=10

# Red con inspeccion HTTPS (SELF_SIGNED_CERT_IN_CHAIN): usar certificados del sistema (Node >= 22.15)
# NODE_OPTIONS=--use-system-ca
